<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="document_hub_document_tree_view" model="ir.ui.view">
            <field name="name">Document hub document tree view</field>
            <field name="model">document_hub.document</field>
            <field name="arch" type="xml">
                <tree string="Documents">
                    <field name="name" />
                    <field name="topic" optional="show" />
                    <field name="folder_id" optional="show" />
                    <field name="description" optional="show" />
                    <field name="tag_ids" widget="many2many_tags" optional="show" />
                    <field name="confidentiality" optional="show" widget="badge"
                           decoration-success="confidentiality == 'public'"
                           decoration-warning="confidentiality == 'confidential'"
                           decoration-danger="confidentiality == 'strictly_confidential'" />
                    <field name="partner_id" optional="hide" />
                    <field name="project_id" optional="hide" />
                    <field name="create_date" optional="hide" />
                    <field name="owner_id" optional="show" widget="many2one_avatar_user" />
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" optional="hide" />
                    <field name="is_admin" column_invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="document_hub_document_kanban_view" model="ir.ui.view">
            <field name="name">document_hub.document.kanban.view</field>
            <field name="model">document_hub.document</field>
            <field name="arch" type="xml">
                <!-- js_class="document_hub_kanban" replaces the rendering below entirely
                     (see static/src/document_explorer/): folder tree, breadcrumb, subfolder
                     tiles and document tiles are all rendered by DocumentHubKanbanRenderer,
                     which fetches its own data instead of using this arch/list. The minimal
                     kanban-box template below only exists because the standard KanbanView
                     machinery (ArchParser, Controller, sample-data empty Model) still runs
                     in the background and requires a valid arch to parse. -->
                <kanban js_class="document_hub_kanban" quick_create="false" group_create="false" create="false">
                    <field name="name"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div><field name="name"/></div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="document_hub_document_form_view" model="ir.ui.view">
            <field name="name">Document hub document form view</field>
            <field name="model">document_hub.document</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button string='Lock' name='action_lock_document' class="btn btn-secondary" type='object' invisible="state == 'lock'" groups="document_hub.group_document_hub_document_director"/>
                        <button string='Unlock' name='action_open_document' class="btn btn-secondary" type='object' invisible="state == 'open'" groups="document_hub.group_document_hub_document_director"/>
                        <field name="state" widget="statusbar" statusbar_visible="lock" />
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name"/>
                            </h1>
                            <label for="topic"/>
                            <h2>
                                <field name="topic" placeholder="e.g. Project contract" readonly="state == 'lock'"/>
                            </h2>
                        </div>
                        <field name="is_admin" invisible="1"/>
                        <field name="can_manage_confidentiality" invisible="1"/>
                        <group name="basic" col="4">
                            <field name="tag_ids" widget="many2many_tags" />
                            <field name="folder_id" readonly="state == 'lock'" options="{'no_create_edit': True, 'no_create': True,}"/>
                            <field name="rel_is_project" invisible="1"/>
                            <field name="rel_is_parent_folder_project" invisible="1"/>
                            <field name="project_id" readonly="state == 'lock'" invisible='not folder_id or rel_is_project != True' options="{'no_create_edit': True, 'no_create': True,}"/>
                        </group>
                        <group name='general' string='General' col="2">
                            <group col='2'>
                                <field name="file_ids" widget="many2many_binary" colspan="2" readonly="state == 'lock'"/>
                            </group>
                            <group col='2'>
                                <field name="owner_id" options="{'no_create_edit': True, 'no_create': True,}" widget="many2one_avatar_user" readonly="state == 'lock'"/>
                                <field name="partner_id" widget="res_partner_many2one" context="{'search_default_customer':1, 'show_address': 1}" options="{&quot;always_reload&quot;: True}" readonly="state == 'lock'" />
                                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" readonly="state == 'lock'"/>
                            </group>
                        </group>

                        <group name="confidentiality" string="Confidentiality">
                            <group>
                                <field name="confidentiality" widget="radio" readonly="state == 'lock'"/>
                                <field name="authorized_user_ids" widget="many2many_tags_avatar"
                                       readonly="state == 'lock' or not can_manage_confidentiality"
                                       options="{'no_create': True}"/>
                            </group>
                            <group>
                                <div class="alert alert-light mb-0" role="note" colspan="2">
                                    <p class="mb-1"><b>Public</b> - may be shared outside the company without harm
                                        (catalogues, presentations, certificates, published price lists).
                                        Every Document hub user can open it, whatever the folder.</p>
                                    <p class="mb-1"><b>Internal</b> - everyday working documents
                                        (procedures, minutes, correspondence, project documentation).
                                        Only the departments selected on the folder and the Director, Manager and Administrator can open it.</p>
                                    <p class="mb-1"><b>Confidential</b> - disclosure could harm the company or a customer
                                        (contracts, NDAs, priced offers, project finances).
                                        Only the owner, the authorized persons and the Director, Manager and Administrator can open it.</p>
                                    <p class="mb-1"><b>Strictly confidential</b> - the highest protection
                                        (personal and payroll data, management board and legal matters, and the company's technical know-how:
                                        electrical diagram designs of cabinets and switchgear, PLC and PCS7 controller programs, robot programs,
                                        as well as administrator account credentials).
                                        Only the owner, the authorized persons and the Manager and Administrator can open it.</p>
                                    <p class="mb-0 text-muted">Anyone who can edit the document may raise its level.
                                        Lowering it and choosing the authorized persons is reserved for the owner and the Manager.
                                        Authorized persons can open the document but not edit it.</p>
                                </div>
                            </group>
                        </group>

                        <group name='description' string='Description' col="2">
                            <field name="description" nolabel="1" colspan="2" placeholder="Enter a description of the documents so they can be more easily identified.." readonly="state == 'lock'"/>
                        </group>

                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" groups="base.group_user" />
                        <field name="activity_ids" widget="mail_activity" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>

        <record id="document_hub_document_view_search" model="ir.ui.view">
            <field name="name">document_hub_document_view.search</field>
            <field name="model">document_hub.document</field>
            <field name="arch" type="xml">
                <search>
                    <field name="topic" />
                    <field name="name" />
                    <field name="description" />
                    <field name="folder_id" />
                    <field name="project_id" />
                    <field name="partner_id" />
                    <field name="tag_ids" />
                    <field name="authorized_user_ids" />
                    <filter name="filter_public" string="Public" domain="[('confidentiality', '=', 'public')]" />
                    <filter name="filter_internal" string="Internal" domain="[('confidentiality', '=', 'internal')]" />
                    <filter name="filter_confidential" string="Confidential" domain="[('confidentiality', '=', 'confidential')]" />
                    <filter name="filter_strictly_confidential" string="Strictly confidential" domain="[('confidentiality', '=', 'strictly_confidential')]" />
                    <group expand="1" string="Group By">
                        <filter name="group_by_folder_id" string="Folder" context="{'group_by':'folder_id'}" />
                        <filter name="group_by_confidentiality" string="Confidentiality" context="{'group_by':'confidentiality'}" />
                    </group>
                </search>
            </field>
        </record>

        <record id="document_hub_mail_document_act" model="ir.actions.act_window">
            <field name="name">Documents</field>
            <field name="res_model">document_hub.document</field>
            <field name="view_mode">kanban,tree,form</field>
            <field name="domain" eval="False"/>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Let's get start. Upload new document!
                </p>
            </field>
        </record>

    </data>

    <menuitem name="Document hub" id="menu_root" web_icon="document_hub,static/description/icon.png" />
    <menuitem name="Documents" id="menu_document_hub" parent="menu_root" sequence="10">
        <menuitem name="Documents" id="menu_document_hub_mail_documents" sequence="10" action="document_hub_mail_document_act" />
    </menuitem>

</odoo>
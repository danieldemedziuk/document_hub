<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="document_hub.FolderPickerDialog">
        <Dialog title="title" size="'md'" contentClass="'o_document_hub_folder_picker_dialog'">
            <div t-if="!rows.length" class="text-muted text-center p-3" t-esc="noFoldersLabel"/>
            <div t-else="" class="o_document_hub_folder_picker">
                <div t-foreach="rows" t-as="folder" t-key="folder.id"
                     class="o_document_hub_folder_picker_row d-flex align-items-center"
                     t-attf-class="{{ state.selectedId === folder.id ? 'o_document_hub_folder_picker_row_selected' : '' }}"
                     t-attf-style="padding-left: {{ 12 + folder.depth * 20 }}px"
                     t-on-click="() => this.select(folder.id)">
                    <i class="fa fa-folder o_document_hub_folder_picker_icon"/>
                    <span class="text-truncate" t-esc="folder.name"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary" t-att-disabled="!state.selectedId" t-on-click="confirm">
                    <t t-esc="moveLabel"/>
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="() => this.props.close()">
                    <t t-esc="cancelLabel"/>
                </button>
            </t>
        </Dialog>
    </t>

</templates>

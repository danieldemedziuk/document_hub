<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="document_hub.ConfirmPurgeDialog">
        <Dialog title="title" size="'md'">
            <p t-esc="instructionLabel"/>
            <input type="text" class="form-control" t-model="state.typed"
                   t-on-keydown="(ev) => { if (ev.key === 'Enter') this.confirm(); }"/>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-danger fw-bold" t-att-disabled="!canConfirm" t-on-click="confirm">
                    <t t-esc="confirmLabel"/>
                </button>
                <button type="button" class="btn btn-secondary" t-on-click="() => this.props.close()">
                    <t t-esc="cancelLabel"/>
                </button>
            </t>
        </Dialog>
    </t>

</templates>

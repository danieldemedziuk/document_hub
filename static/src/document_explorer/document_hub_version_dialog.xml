<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="document_hub.VersionDialog">
        <Dialog title="title" size="'md'">
            <div t-if="!state.versions.length" class="text-muted" t-esc="noVersionsLabel"/>
            <table t-else="" class="table table-sm align-middle mb-0">
                <tbody>
                    <tr t-foreach="state.versions" t-as="version" t-key="version.id">
                        <td>
                            <img t-if="version.create_uid" class="o_document_hub_version_avatar rounded-circle me-2"
                                 t-att-src="avatarUrl(version.create_uid[0])" t-att-title="version.create_uid[1]" alt=""/>
                        </td>
                        <td>
                            <a t-att-href="downloadUrl(version.attachment_id[0])" t-esc="version.attachment_id[1]"/>
                        </td>
                        <td class="text-muted" t-esc="formatVersionDate(version)"/>
                        <td class="text-end">
                            <button type="button" class="btn btn-link btn-sm p-0" t-on-click="() => this.restore(version)">
                                <t t-esc="restoreLabel"/>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-secondary" t-on-click="() => this.props.close()">
                    <t t-esc="closeLabel"/>
                </button>
            </t>
        </Dialog>
    </t>

</templates>

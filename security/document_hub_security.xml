<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="module_document_hub_category" model="ir.module.category">
        <field name="name">Document hub</field>
        <field name="description">Allows you to advanced manage your documents.</field>
        <field name="sequence">60</field>
        <field name="visible" eval="True" />
    </record>

    <record id="group_document_hub_document_administration" model="res.groups">
        <field name="name">Administration</field>
        <field name="category_id" ref="module_document_hub_category" />
    </record>

    <record id="group_document_hub_document_purchasing_and_logistics" model="res.groups">
        <field name="name">Purchasing and logistics</field>
        <field name="category_id" ref="module_document_hub_category" />
    </record>

    <record id="group_document_hub_document_marketing" model="res.groups">
        <field name="name">Marketing</field>
        <field name="category_id" ref="module_document_hub_category" />
    </record>

    <record id="group_document_hub_document_production" model="res.groups">
        <field name="name">Production</field>
        <field name="category_id" ref="module_document_hub_category" />
    </record>

    <record id="group_document_hub_document_accounting" model="res.groups">
        <field name="name">Accounting</field>
        <field name="category_id" ref="module_document_hub_category" />
    </record>

    <record id="group_document_hub_document_salesman" model="res.groups">
        <field name="name">Sales</field>
        <field name="category_id" ref="module_document_hub_category" />
    </record>

    <record id="group_document_hub_document_pm" model="res.groups">
        <field name="name">Project manager</field>
        <field name="category_id" ref="module_document_hub_category" />
    </record>

    <record id="group_document_hub_document_hr" model="res.groups">
        <field name="name">Human resources</field>
        <field name="category_id" ref="module_document_hub_category" />
    </record>

    <record id="group_document_hub_document_everyone" model="res.groups">
        <field name="name">Everyone</field>
        <field name="category_id" ref="module_document_hub_category" />
    </record>

    <record id="group_document_hub_folder_creator" model="res.groups">
        <field name="name">Can create folders</field>
        <field name="category_id" ref="module_document_hub_category" />
    </record>

    <record id="group_document_hub_document_director" model="res.groups">
        <field name="name">Director</field>
        <field name="category_id" ref="module_document_hub_category" />
        <field name="implied_ids" eval="[(4, ref('group_document_hub_folder_creator'))]" />
    </record>

    <record id="group_document_hub_document_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_document_hub_category" />
        <field name="implied_ids" eval="[(4, ref('group_document_hub_document_director'))]" />
    </record>

    <record id="group_document_hub_document_administrator" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_document_hub_category" />
        <field name="implied_ids" eval="[(4, ref('group_document_hub_document_manager'))]" />
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>

    <data noupdate="1">

        <record id="document_hub_document_multi_company" model="ir.rule">
            <field name="name">Document hub Multi-Company</field>
            <field name="model_id" ref="model_document_hub_document" />
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="document_hub_folder_multi_company" model="ir.rule">
            <field name="name">Document hub folder Multi-Company</field>
            <field name="model_id" ref="model_document_hub_folder" />
            <field name="domain_force">[('company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="document_hub_document_version_multi_company" model="ir.rule">
            <field name="name">Document hub document version Multi-Company</field>
            <field name="model_id" ref="model_document_hub_document_version" />
            <field name="domain_force">[('document_id.company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="documents_hub_document_administration_rule" model="ir.rule">
            <field name="name">Document hub document: administration rule</field>
            <field name="model_id" ref="model_document_hub_document" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_administration'))]" />
            <field name="domain_force">[('rel_visibility_administration', '=' , True)]</field>
        </record>

        <record id="documents_hub_document_purchasing_and_logistics_rule" model="ir.rule">
            <field name="name">Document hub document: purchasing and logistics rule</field>
            <field name="model_id" ref="model_document_hub_document" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_purchasing_and_logistics'))]" />
            <field name="domain_force">[('rel_visibility_purchasing_and_logistics', '=' , True)]</field>
        </record>

        <record id="documents_hub_document_marketing_rule" model="ir.rule">
            <field name="name">Document hub document: marketing rule</field>
            <field name="model_id" ref="model_document_hub_document" />
            <field name="groups"
                eval="[(4, ref('document_hub.group_document_hub_document_marketing'))]" />
            <field name="domain_force">[('rel_visibility_marketing', '=' , True)]</field>
        </record>

        <record id="documents_hub_document_production_rule" model="ir.rule">
            <field name="name">Document hub document: production rule</field>
            <field name="model_id" ref="model_document_hub_document" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_production'))]" />
            <field name="domain_force">[('rel_visibility_production', '=' , True)]</field>
        </record>

        <record id="documents_hub_document_sales_rule" model="ir.rule">
            <field name="name">Document hub document: sales rule</field>
            <field name="model_id" ref="model_document_hub_document" />
            <field name="groups"
                eval="[(4, ref('document_hub.group_document_hub_document_salesman'))]" />
            <field name="domain_force">[('rel_visibility_salesman', '=' , True)]</field>
        </record>

        <record id="documents_hub_document_accounting_rule" model="ir.rule">
            <field name="name">Document hub document: accounting rule</field>
            <field name="model_id" ref="model_document_hub_document" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_accounting'))]" />
            <field name="domain_force">[('rel_visibility_accounting', '=' , True)]</field>
        </record>

        <record id="documents_hub_document_everyone_rule" model="ir.rule">
            <field name="name">Document hub document: everyone rule</field>
            <field name="model_id" ref="model_document_hub_document" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_everyone'))]" />
            <field name="domain_force">[('rel_visibility_everyone', '=' , True)]</field>
        </record>

        <record id="documents_hub_document_pm_rule" model="ir.rule">
            <field name="name">Document hub document: pm rule</field>
            <field name="model_id" ref="model_document_hub_document" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_pm'))]" />
            <field name="domain_force">[('rel_visibility_pm', '=' , True),
                ('project_id.privacy_visibility', '=', 'followers'), '|',
                ('project_id.message_partner_ids', 'in', [user.partner_id.id]),
                ('project_id.user_id', '=', user.id)]</field>
        </record>

        <record id="documents_hub_document_hr_rule" model="ir.rule">
            <field name="name">Document hub document: hr rule</field>
            <field name="model_id" ref="model_document_hub_document" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_hr'))]" />
            <field name="domain_force">[('rel_visibility_hr', '=' , True)]</field>
        </record>


        <record id="documents_hub_document_director_rule" model="ir.rule">
            <field name="name">Document hub document: director rule</field>
            <field name="model_id" ref="model_document_hub_document" />
            <field name="groups"
                eval="[(4, ref('document_hub.group_document_hub_document_director'))]" />
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

        <!-- These 9 department rules are read-visibility filters only (that's
             what the visibility_x fields are for) - explicitly scoped to
             perm_read so they don't also gate create/write/unlink. Without
             this, a freshly-created folder (no visibility flags set yet,
             since that's only chosen afterwards in the folder form) never
             satisfies any of these domains, so ir.rule denies the create
             outright regardless of what ir.model.access.csv allows - this is
             what silently broke folder creation for group_document_hub_folder_creator
             (and for group_document_hub_document_administration, which already
             had perm_create=1/perm_write=1 in the ACL but could never actually
             use it). The director/manager/administrator catch-all rule below
             is intentionally left applying to all operations. -->
        <record id="documents_hub_folder_administration_rule" model="ir.rule">
            <field name="name">Document hub folder: administration rule</field>
            <field name="model_id" ref="model_document_hub_folder" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_administration'))]" />
            <field name="domain_force">[('visibility_administration', '=' , True)]</field>
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="documents_hub_folder_purchasing_and_logistics_rule" model="ir.rule">
            <field name="name">Document hub folder: purchasing and logistics rule</field>
            <field name="model_id" ref="model_document_hub_folder" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_purchasing_and_logistics'))]" />
            <field name="domain_force">[('visibility_purchasing_and_logistics', '=' , True)]</field>
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="documents_hub_folder_marketing_rule" model="ir.rule">
            <field name="name">Document hub folder: marketing rule</field>
            <field name="model_id" ref="model_document_hub_folder" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_marketing'))]" />
            <field name="domain_force">[('visibility_marketing', '=' , True)]</field>
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="documents_hub_folder_production_rule" model="ir.rule">
            <field name="name">Document hub folder: production rule</field>
            <field name="model_id" ref="model_document_hub_folder" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_production'))]" />
            <field name="domain_force">[('visibility_production', '=' , True)]</field>
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="documents_hub_folder_sales_rule" model="ir.rule">
            <field name="name">Document hub folder: sales rule</field>
            <field name="model_id" ref="model_document_hub_folder" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_salesman'))]" />
            <field name="domain_force">[('visibility_salesman', '=' , True)]</field>
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="documents_hub_folder_accounting_rule" model="ir.rule">
            <field name="name">Document hub folder: accounting rule</field>
            <field name="model_id" ref="model_document_hub_folder" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_accounting'))]" />
            <field name="domain_force">[('visibility_accounting', '=' , True)]</field>
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="documents_hub_folder_everyone_rule" model="ir.rule">
            <field name="name">Document hub folder: everyone rule</field>
            <field name="model_id" ref="model_document_hub_folder" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_everyone'))]" />
            <field name="domain_force">[('visibility_everyone', '=' , True)]</field>
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="documents_hub_folder_pm_rule" model="ir.rule">
            <field name="name">Document hub folder: pm rule</field>
            <field name="model_id" ref="model_document_hub_folder" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_pm'))]" />
            <field name="domain_force">[('visibility_pm', '=' , True)]</field>
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="documents_hub_folder_hr_rule" model="ir.rule">
            <field name="name">Document hub folder: hr rule</field>
            <field name="model_id" ref="model_document_hub_folder" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_hr'))]" />
            <field name="domain_force">[('visibility_hr', '=' , True)]</field>
            <field name="perm_write" eval="False" />
            <field name="perm_create" eval="False" />
            <field name="perm_unlink" eval="False" />
        </record>

        <record id="documents_hub_folder_director_rule" model="ir.rule">
            <field name="name">Document hub folder: director rule</field>
            <field name="model_id" ref="model_document_hub_folder" />
            <field name="groups"
                eval="[(4, ref('document_hub.group_document_hub_document_director'))]" />
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

        <!-- Someone with "Can create folders" but no broader visibility rule
             granting write/unlink can otherwise create a folder and then
             immediately lose read/write/unlink access to it, since it has no
             visibility_x flag set yet (that's chosen afterwards in the
             folder form). This rule lets a creator see and manage whatever
             they personally created, on top of - not instead of - whatever
             their department visibility rule already grants. -->
        <record id="documents_hub_folder_own_created_rule" model="ir.rule">
            <field name="name">Document hub folder: own created folders (creator group)</field>
            <field name="model_id" ref="model_document_hub_folder" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_folder_creator'))]" />
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
        </record>

        <record id="documents_hub_tag_director_rule" model="ir.rule">
            <field name="name">Document hub tag: director rule</field>
            <field name="model_id" ref="model_document_hub_tag" />
            <field name="groups"
                eval="[(4, ref('document_hub.group_document_hub_document_director'))]" />
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

        <record id="documents_hub_document_version_administration_rule" model="ir.rule">
            <field name="name">Document hub document version: administration rule</field>
            <field name="model_id" ref="model_document_hub_document_version" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_administration'))]" />
            <field name="domain_force">[('document_id.rel_visibility_administration', '=' , True)]</field>
        </record>

        <record id="documents_hub_document_version_purchasing_and_logistics_rule" model="ir.rule">
            <field name="name">Document hub document version: purchasing and logistics rule</field>
            <field name="model_id" ref="model_document_hub_document_version" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_purchasing_and_logistics'))]" />
            <field name="domain_force">[('document_id.rel_visibility_purchasing_and_logistics', '=' , True)]</field>
        </record>

        <record id="documents_hub_document_version_marketing_rule" model="ir.rule">
            <field name="name">Document hub document version: marketing rule</field>
            <field name="model_id" ref="model_document_hub_document_version" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_marketing'))]" />
            <field name="domain_force">[('document_id.rel_visibility_marketing', '=' , True)]</field>
        </record>

        <record id="documents_hub_document_version_production_rule" model="ir.rule">
            <field name="name">Document hub document version: production rule</field>
            <field name="model_id" ref="model_document_hub_document_version" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_production'))]" />
            <field name="domain_force">[('document_id.rel_visibility_production', '=' , True)]</field>
        </record>

        <record id="documents_hub_document_version_sales_rule" model="ir.rule">
            <field name="name">Document hub document version: sales rule</field>
            <field name="model_id" ref="model_document_hub_document_version" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_salesman'))]" />
            <field name="domain_force">[('document_id.rel_visibility_salesman', '=' , True)]</field>
        </record>

        <record id="documents_hub_document_version_accounting_rule" model="ir.rule">
            <field name="name">Document hub document version: accounting rule</field>
            <field name="model_id" ref="model_document_hub_document_version" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_accounting'))]" />
            <field name="domain_force">[('document_id.rel_visibility_accounting', '=' , True)]</field>
        </record>

        <record id="documents_hub_document_version_everyone_rule" model="ir.rule">
            <field name="name">Document hub document version: everyone rule</field>
            <field name="model_id" ref="model_document_hub_document_version" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_everyone'))]" />
            <field name="domain_force">[('document_id.rel_visibility_everyone', '=' , True)]</field>
        </record>

        <record id="documents_hub_document_version_pm_rule" model="ir.rule">
            <field name="name">Document hub document version: pm rule</field>
            <field name="model_id" ref="model_document_hub_document_version" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_pm'))]" />
            <field name="domain_force">[('document_id.rel_visibility_pm', '=' , True),
                ('document_id.project_id.privacy_visibility', '=', 'followers'), '|',
                ('document_id.project_id.message_partner_ids', 'in', [user.partner_id.id]),
                ('document_id.project_id.user_id', '=', user.id)]</field>
        </record>

        <record id="documents_hub_document_version_hr_rule" model="ir.rule">
            <field name="name">Document hub document version: hr rule</field>
            <field name="model_id" ref="model_document_hub_document_version" />
            <field name="groups" eval="[(4, ref('document_hub.group_document_hub_document_hr'))]" />
            <field name="domain_force">[('document_id.rel_visibility_hr', '=' , True)]</field>
        </record>

        <record id="documents_hub_document_version_director_rule" model="ir.rule">
            <field name="name">Document hub document version: director rule</field>
            <field name="model_id" ref="model_document_hub_document_version" />
            <field name="groups"
                eval="[(4, ref('document_hub.group_document_hub_document_director'))]" />
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

    </data>
</odoo>